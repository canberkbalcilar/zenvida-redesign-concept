{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "ZenVida redesign concept",
    "description": "ZenVida Concept theme: simple ritual form, show/hide and drag-and-drop order, every page section an editable block, quick guide on the dashboard.",
    "author": "canberkbalcilar"
  },
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "login": true,
  "steps": [
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "ZenVida",
        "blogdescription": "Foot & Body · Redesign concept",
        "permalink_structure": "/%postname%/",
        "zv_skip_auto_import": "1",
        "timezone_string": "Europe/Madrid"
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://canberkbalcilar.github.io/zenvida-redesign-concept/wordpress/zenvida-concept.zip?v=1.3.0"
      },
      "options": { "activate": true }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; if ( function_exists( 'zv_seed' ) ) { zv_seed(); } flush_rewrite_rules();"
    }
  ]
}
